<?xml version="1.0" encoding="utf-8"?>
<!-- Fire TV Banner (320x180 dp) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#18181B"
                android:endColor="#09090B"
                android:angle="135"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>

    <!-- Red accent line at top -->
    <item android:top="0dp" android:bottom="170dp">
        <shape android:shape="rectangle">
            <solid android:color="#EF4444"/>
        </shape>
    </item>

    <!-- App name text area (placeholder - replace with actual image) -->
    <item
        android:left="20dp"
        android:top="50dp"
        android:right="20dp"
        android:bottom="50dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
        </shape>
    </item>
</layer-list>
