{
  "name": "dispotree-backend",
  "version": "1.0.0",
  "description": "Dispotree backend API",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec 'ts-node --transpile-only' src/index.ts",
    "build": "tsc || true && npm run docs:generate",
    "docs:generate": "node scripts/generate-docs.js",
    "docs:serve": "npm run docs:generate && npm run dev",
    "migrate": "npm run build && sequelize-cli db:migrate",
    "seed": "npm run build && sequelize-cli db:seed:all",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:ml": "ts-node src/tests/viewDurationSignals.test.ts",
    "seed:automations": "ts-node src/seeds/seedDefaultAutomations.ts",
    "seed:extraction-profiles": "ts-node src/seeds/seedExtractionProfiles.ts",
    "validate:extraction": "ts-node src/scripts/validateExtractionSetup.ts",
    "test:extraction": "ts-node src/tests/manual/testExtractionProfiles.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "cd .. && husky install backend/.husky || true"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@langchain/core": "^1.1.6",
    "@langchain/openai": "^1.2.0",
    "@mendable/firecrawl-js": "^1.21.1",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@napi-rs/canvas": "^0.1.80",
    "@pinecone-database/pinecone": "^6.1.3",
    "@scalar/express-api-reference": "^0.8.28",
    "@supabase/supabase-js": "^2.89.0",
    "bcryptjs": "^2.4.3",
    "chokidar": "^5.0.0",
    "chrono-node": "^2.9.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "googleapis": "^144.0.0",
    "helmet": "^7.1.0",
    "imapflow": "^1.0.164",
    "ioredis": "^5.8.2",
    "joi": "^17.13.3",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.2.1",
    "mailparser": "^3.7.1",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.12",
    "openai": "^6.15.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "playwright": "^1.57.0",
    "redis": "^5.10.0",
    "resend": "^6.6.0",
    "sequelize": "^6.35.2",
    "sharp": "^0.34.5",
    "stripe": "^20.1.2",
    "swagger-jsdoc": "^6.2.8",
    "tesseract.js": "^7.0.0",
    "twilio": "^5.11.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.5",
    "@types/pdfkit": "^0.17.4",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.2.0",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
