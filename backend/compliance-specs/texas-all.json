  "scoringRules": {
    "green": {
      "description": "All critical Texas rules pass, all 3 required disclosures present",
      "conditions": [
        "Grantee matches LLC (TX-P3-R1)",
        "Contract assignable (TX-P3-R3)",
        "Contract not expired (TX-P3-R4)",
        "Grantor signature present (TX-P3-R5)",
        "All 3 Texas disclosures present (TX-D1, TX-D2, TX-D3)",
        "Assignment rights disclosed (§5.069(b)(1))",
        "Assignment fee disclosed (§5.069(b)(2))",
        "Not licensed broker disclosed (TREC §537.11)"
      ],
      "permissions": {
        "canDistribute": true,
        "canExecuteAssignment": true
      }
    },
    "yellow": {
      "description": "Minor issues - manual review required",
      "conditions": [
        "2 of 3 disclosures present (missing 1 non-critical)",
        "Grantor name doesn't match public records (warning only)",
        "No option period specified (recommended but not blocking)",
        "Contract near expiration (< 14 days)"
      ],
      "permissions": {
        "canDistribute": false,
        "canExecuteAssignment": false
      },
      "remediationAllowed": true,
      "maxRemediationAttempts": 2
    },
    "red": {
      "description": "Critical failure - deal rejected",
      "conditions": [
        "Grantee doesn't match LLC (TX-P3-R1)",
        "Contract not assignable (TX-P3-R3)",
        "Contract expired (TX-P3-R4)",
        "Grantor signature missing (TX-P3-R5)",
        "Missing assignment fee disclosure (TX-D2) - HIGH RISK per §5.069",
        "1 or fewer disclosures present (< 50% compliance)"
      ],
      "permissions": {
        "canDistribute": false,
        "canExecuteAssignment": false
      },
      "autoReject": true
    }
  },
  "blockingGates": [
    {
      "gateId": "TX-GATE-1",
      "name": "LLC Hard Gate",
      "phase": 0,
      "blocksPhase": 2,
      "condition": "LLC profile complete AND Certificate of Formation uploaded AND Company Agreement uploaded AND Governing person identified AND CSA executed",
      "errorMessage": "Cannot submit deal without complete LLC setup. Texas requires: Certificate of Formation, Company Agreement, Governing Person, and executed CSA."
    },
    {
      "gateId": "TX-GATE-2",
      "name": "TREC Contract Validation Gate",
      "phase": 3,
      "blocksPhase": 4,
      "condition": "All Phase 3 TREC contract rules pass (grantee matches LLC, assignable, not expired, grantor signature)",
      "errorMessage": "TREC contract validation failed. Fix critical issues before proceeding to disclosure validation."
    },
    {
      "gateId": "TX-GATE-3",
      "name": "Compliance Status Gate",
      "phase": 5,
      "blocksPhase": 6,
      "condition": "Overall compliance status = GREEN",
      "errorMessage": "Cannot distribute deal with YELLOW or RED compliance status. All 3 Texas disclosures required per Property Code §5.069."
    },
    {
      "gateId": "TX-GATE-4",
      "name": "Assignment Fee Disclosure Gate",
      "phase": 4,
      "blocksPhase": 11,
      "condition": "Assignment compensation disclosed (TX-D2)",
      "errorMessage": "CRITICAL: Cannot execute assignment without fee disclosure - LAWSUIT RISK per Texas Property Code §5.069(b)(2)"
    },
    {
      "gateId": "TX-GATE-5",
      "name": "Distribution Agreements Gate",
      "phase": 7,
      "blocksPhase": 8,
      "condition": "MSA executed (if distributing) AND ASA executed (if using auction)",
      "errorMessage": "Cannot proceed without executed distribution agreements (MSA and/or ASA as applicable)."
