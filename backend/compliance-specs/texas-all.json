  "rules": [
    {
      "ruleId": "TX-P0-R1",
      "phase": 0,
      "description": "LLC must be selected before deal submission",
      "validationType": "field_present",
      "validation": {
        "field1": "selectedLlcId",
        "operator": "present",
        "customLogic": "return deal.selectedLlcId !== null && deal.selectedLlcId !== undefined"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "No LLC selected - please select or create an LLC before submitting",
      "remediation": "Select an existing LLC or create a new LLC profile"
    },
    {
      "ruleId": "TX-P0-R2",
      "phase": 0,
      "description": "Texas Certificate of Formation must be uploaded",
      "validationType": "field_present",
      "validation": {
        "field1": "certificateDocumentId",
        "operator": "present",
        "customLogic": "return llc.documents.some(d => d.documentType === 'certificate' && d.status === 'verified')"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Certificate of Formation not uploaded",
      "remediation": "Upload Texas Secretary of State Certificate of Formation"
    },
    {
      "ruleId": "TX-P0-R3",
      "phase": 0,
      "description": "Company Agreement must be uploaded",
      "validationType": "field_present",
      "validation": {
        "field1": "companyAgreementId",
        "operator": "present",
        "customLogic": "return llc.documents.some(d => d.documentType === 'company_agreement' && d.status === 'verified')"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Company Agreement not uploaded (Texas uses 'Company Agreement' not 'Operating Agreement')",
      "remediation": "Upload LLC Company Agreement showing governing persons"
    },
    {
      "ruleId": "TX-P0-R4",
      "phase": 0,
      "description": "Authorized signer/governing person must be identified",
      "validationType": "field_present",
      "validation": {
        "field1": "authorizedSignerId",
        "operator": "present",
        "customLogic": "return llc.authorizedSigners.length > 0"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "No authorized signer identified",
      "remediation": "Identify governing person with signing authority from Company Agreement"
    },
    {
      "ruleId": "TX-P0-R5",
      "phase": 0,
      "description": "CSA must be executed",
      "validationType": "field_present",
      "validation": {
        "field1": "csaId",
        "operator": "present",
        "customLogic": "return llc.agreements.some(a => a.agreementType === 'CSA' && a.status === 'executed')"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Client Services Agreement not executed",
      "remediation": "Execute CSA via DocuSeal with authorized signer"
    },
    {
      "ruleId": "TX-P2-R1",
      "phase": 2,
      "description": "TREC contract must be uploaded",
      "validationType": "field_present",
      "validation": {
        "field1": "trecContractId",
        "operator": "present",
        "customLogic": "return property.documents.some(d => d.category === 'purchase_contract' && d.documentType.includes('trec'))"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "TREC 1-4 Family Residential Contract not uploaded",
      "remediation": "Upload signed TREC contract"
    },
    {
      "ruleId": "TX-P2-R2",
      "phase": 2,
      "description": "TREC contract OCR must succeed",
      "validationType": "field_present",
      "validation": {
        "field1": "ocrComplete",
        "operator": "equals",
        "expectedValue": true,
        "customLogic": "return ocrResult && ocrResult.extractionStatus === 'complete'"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "OCR extraction failed - cannot validate TREC contract",
      "remediation": "Re-upload clearer scan or manually verify fields"
    },
    {
      "ruleId": "TX-P3-R1",
      "phase": 3,
      "description": "Grantee name must match selected LLC",
      "validationType": "field_match",
      "validation": {
        "field1": "granteeName",
        "field2": "selectedLLC.legalName",
        "operator": "contains",
        "customLogic": "const normalized = (ocrResult.granteeName || ocrResult.buyerName || '').toUpperCase().replace(/\\s+/g, ' ').trim(); const llcNorm = selectedLLC.legalName.toUpperCase().replace(/\\s+/g, ' ').trim(); return normalized.includes(llcNorm) || normalized.includes(llcNorm.replace(/,?\\s*LLC$/, ''))"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Grantee name does not match selected LLC (Texas uses 'Grantee' for buyer)",
      "remediation": "Verify contract grantee matches LLC legal name exactly"
    },
    {
      "ruleId": "TX-P3-R2",
      "phase": 3,
      "description": "Grantor name must match public records",
      "validationType": "field_match",
      "validation": {
        "field1": "grantorName",
        "field2": "publicRecords.ownerName",
        "operator": "contains",
        "customLogic": "const normalized = (ocrResult.grantorName || ocrResult.sellerName || '').toUpperCase(); const publicNorm = (publicRecords.ownerName || '').toUpperCase(); return normalized.includes(publicNorm) || publicNorm.includes(normalized)"
      },
      "blocking": false,
      "severity": "warning",
      "errorMessage": "Grantor name may not match public records - manual review needed (Texas uses 'Grantor' for seller)",
      "remediation": "Verify grantor is current owner via deed search"
    },
    {
      "ruleId": "TX-P3-R3",
      "phase": 3,
      "description": "Contract must be assignable",
      "validationType": "boolean_check",
      "validation": {
        "field1": "assignable",
        "operator": "equals",
        "expectedValue": true,
        "customLogic": "return ocrResult.assignable === true || (ocrResult.granteeName || ocrResult.buyerName || '').toLowerCase().includes('and/or assigns')"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Contract is not assignable - wholesale deals require assignment rights",
      "remediation": "TREC contract must include 'and/or assigns' in grantee name or explicit assignment clause"
    },
    {
      "ruleId": "TX-P3-R4",
      "phase": 3,
      "description": "Contract must not be expired",
      "validationType": "date_comparison",
      "validation": {
        "field1": "contractExpirationDate",
        "operator": "greater_than",
        "field2": "currentDate",
        "customLogic": "return new Date(ocrResult.contractExpirationDate) > new Date()"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "TREC contract has expired",
      "remediation": "Contract expiration date must be in the future"
    },
    {
      "ruleId": "TX-P3-R5",
      "phase": 3,
      "description": "Grantor signature must be present",
      "validationType": "boolean_check",
      "validation": {
        "field1": "grantorSignature",
        "operator": "equals",
        "expectedValue": true,
        "customLogic": "return ocrResult.grantorSignature === true || ocrResult.sellerSignature === true"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Grantor signature not detected on TREC contract",
      "remediation": "Contract must be signed by grantor (seller)"
    },
    {
      "ruleId": "TX-P3-R6",
      "phase": 3,
      "description": "Option period recommended for wholesale deals",
      "validationType": "field_present",
      "validation": {
        "field1": "optionPeriod",
        "operator": "present",
        "customLogic": "return ocrResult.optionPeriod && parseInt(ocrResult.optionPeriod) > 0"
      },
      "blocking": false,
      "severity": "warning",
      "errorMessage": "No option period specified - recommended for wholesale (allows time to find buyer)",
      "remediation": "TREC contracts typically include 7-10 day option period for due diligence"
    },
    {
      "ruleId": "TX-P4-R1",
      "phase": 4,
      "description": "Assignment rights must be disclosed (TX Property Code §5.069)",
      "validationType": "field_present",
      "validation": {
        "field1": "disclosure_assignment_rights",
        "operator": "equals",
        "expectedValue": true
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Missing Texas-required assignment disclosure (Property Code §5.069(b)(1))",
      "remediation": "Texas Property Code §5.069 requires disclosure of intent to assign"
    },
    {
      "ruleId": "TX-P4-R2",
      "phase": 4,
      "description": "Assignment fee must be disclosed to seller (TX Property Code §5.069)",
      "validationType": "field_present",
      "validation": {
        "field1": "disclosure_assignment_fee",
        "operator": "equals",
        "expectedValue": true
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Missing assignment fee disclosure - HIGH RISK (Property Code §5.069(b)(2))",
      "remediation": "Texas requires disclosure of assignment compensation to seller (prevents lawsuits)"
    },
    {
      "ruleId": "TX-P4-R3",
      "phase": 4,
      "description": "Must disclose not a licensed broker (TREC Rules §537.11)",
      "validationType": "field_present",
      "validation": {
        "field1": "disclosure_not_licensed_broker",
        "operator": "equals",
        "expectedValue": true
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Missing 'not a licensed broker' disclosure (TREC Rules §537.11)",
      "remediation": "Texas requires disclosure if buyer is not a licensed real estate broker"
    },
    {
      "ruleId": "TX-P5-R1",
      "phase": 5,
      "description": "Calculate overall compliance score",
      "validationType": "custom",
      "validation": {
        "customLogic": "const phase3Pass = compliance.phase3Status === 'GREEN'; const phase4Score = [compliance.disclosureAssignmentRights, compliance.disclosureAssignmentFee, compliance.disclosureNotLicensedBroker].filter(d => d === true).length; return phase3Pass && phase4Score === 3 ? 'GREEN' : (phase4Score >= 2 ? 'YELLOW' : 'RED')"
      },
      "blocking": false,
      "severity": "info",
      "errorMessage": "Compliance score calculated",
      "remediation": "Review compliance dashboard for details"
    },
    {
      "ruleId": "TX-P6-R1",
      "phase": 6,
      "description": "Distribution requires GREEN status",
      "validationType": "field_match",
      "validation": {
        "field1": "overallStatus",
        "operator": "equals",
        "expectedValue": "GREEN",
        "customLogic": "return compliance.overallStatus === 'GREEN'"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Cannot distribute with YELLOW or RED compliance status",
      "remediation": "Fix compliance issues to achieve GREEN status before distribution"
    },
    {
      "ruleId": "TX-P7-R1",
      "phase": 7,
      "description": "MSA must be executed if distributing",
      "validationType": "field_present",
      "validation": {
        "field1": "msaId",
        "operator": "present",
        "customLogic": "return property.agreements.some(a => a.agreementType === 'MSA' && a.status === 'executed')"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Cannot distribute without executed MSA",
      "remediation": "Execute Marketing Services Agreement via DocuSeal"
    },
    {
      "ruleId": "TX-P7-R2",
      "phase": 7,
      "description": "ASA required for auction channel",
      "validationType": "field_present",
      "validation": {
        "field1": "asaId",
        "operator": "present",
        "customLogic": "if (!distributionChannels.includes('auction')) return true; return property.agreements.some(a => a.agreementType === 'ASA' && a.status === 'executed')"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Cannot use auction channel without executed ASA",
      "remediation": "Execute Auction Services Agreement"
    },
    {
      "ruleId": "TX-P8-R1",
      "phase": 8,
      "description": "Broker review required before distribution",
      "validationType": "field_present",
      "validation": {
        "field1": "brokerReviewId",
        "operator": "present",
        "customLogic": "return property.reviews.some(r => r.reviewType === 'broker' && r.decision !== null)"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Deal pending broker review",
      "remediation": "Wait for broker approval"
    },
    {
      "ruleId": "TX-P8-R2",
      "phase": 8,
      "description": "Broker must approve for distribution",
      "validationType": "field_match",
      "validation": {
        "field1": "brokerDecision",
        "operator": "equals",
        "expectedValue": "approved",
        "customLogic": "const review = property.reviews.find(r => r.reviewType === 'broker'); return review && review.decision === 'approved'"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Broker has not approved distribution",
      "remediation": "Address broker's concerns and request re-review"
    },
    {
      "ruleId": "TX-P11-R1",
      "phase": 11,
      "description": "End buyer details must be provided",
      "validationType": "field_present",
      "validation": {
        "field1": "assigneeName",
        "operator": "present",
        "customLogic": "return compliance.assigneeName && compliance.assigneeName.trim().length > 0"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "End buyer information missing",
      "remediation": "Provide end buyer/assignee contact details"
    },
    {
      "ruleId": "TX-P11-R2",
      "phase": 11,
      "description": "TREC assignment addendum must be uploaded",
      "validationType": "field_present",
      "validation": {
        "field1": "assignmentAgreementId",
        "operator": "present",
        "customLogic": "return property.documents.some(d => d.category === 'assignment_agreement' || d.documentType.includes('assignment'))"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "TREC Assignment of Contract addendum not uploaded",
      "remediation": "Upload executed TREC Assignment of Contract and Earnest Money form"
    },
    {
      "ruleId": "TX-P11-R3",
      "phase": 11,
      "description": "Assignor name must match wholesaler LLC",
      "validationType": "field_match",
      "validation": {
        "field1": "assignorName",
        "field2": "selectedLLC.legalName",
        "operator": "contains",
        "customLogic": "const normalized = (ocrResult.assignorName || '').toUpperCase(); const llcNorm = selectedLLC.legalName.toUpperCase(); return normalized.includes(llcNorm)"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Assignor does not match wholesaler LLC",
      "remediation": "TREC assignment must be from the LLC that holds the original contract"
    },
    {
      "ruleId": "TX-P11-R4",
      "phase": 11,
      "description": "Assignment property must match original TREC contract",
      "validationType": "field_match",
      "validation": {
        "field1": "assignmentPropertyAddress",
        "field2": "originalPropertyAddress",
        "operator": "contains",
        "customLogic": "const assignAddr = (ocrResult.propertyAddress || '').toUpperCase().replace(/[^A-Z0-9]/g, ''); const origAddr = (property.address || '').toUpperCase().replace(/[^A-Z0-9]/g, ''); return assignAddr === origAddr"
      },
      "blocking": true,
      "severity": "critical",
      "errorMessage": "Assignment property address does not match original TREC contract",
      "remediation": "Property address on assignment must match purchase contract exactly"
    },
    {
      "ruleId": "TX-P11-R5",
      "phase": 11,
      "description": "Assignment fee must be specified",
      "validationType": "field_present",
      "validation": {
        "field1": "assignmentFee",
        "operator": "present",
        "customLogic": "return ocrResult.assignmentFee && parseFloat(ocrResult.assignmentFee) > 0"
      },
      "blocking": false,
      "severity": "warning",
      "errorMessage": "Assignment fee not extracted - verify disclosure compliance",
      "remediation": "Ensure assignment fee is clearly stated on TREC assignment form"
    },
    {
      "ruleId": "TX-P11-R6",
      "phase": 11,
      "description": "Earnest money assignment must be addressed",
      "validationType": "field_present",
      "validation": {
        "field1": "earnestMoneyAssignment",
        "operator": "present",
        "customLogic": "return ocrResult.earnestMoneyAssignment !== undefined"
      },
      "blocking": false,
      "severity": "warning",
      "errorMessage": "Earnest money assignment not specified",
      "remediation": "TREC assignment form should specify earnest money handling"
    }
  ],
  "disclosures": [
    {
      "disclosureId": "TX-D1",
      "name": "Assignment Rights Disclosure",
      "description": "Buyer must disclose intent to assign contract to another party",
      "legalCitation": "Texas Property Code §5.069(b)(1)",
      "required": true,
      "substanceRequired": true,
      "keywords": [
        "assign",
        "assignment",
        "transfer",
        "equitable interest",
        "subsequent purchaser",
        "and/or assigns"
      ],
      "regexPattern": "/(?:assign|assignment|transfer.{0,30}contract|equitable\\s+interest|subsequent\\s+purchaser)/i"
    },
    {
      "disclosureId": "TX-D2",
      "name": "Assignment Compensation Disclosure",
      "description": "Assignment fee must be disclosed to seller",
      "legalCitation": "Texas Property Code §5.069(b)(2)",
      "required": true,
      "substanceRequired": true,
      "keywords": [
        "assignment fee",
        "assignment compensation",
        "wholesale fee",
        "consideration",
        "profit"
      ],
      "regexPattern": "/(?:assignment\\s+(?:fee|compensation|profit)|wholesale\\s+fee|consideration).{0,40}(?:\\$[\\d,]+|\\d+%)/i"
    },
    {
      "disclosureId": "TX-D3",
      "name": "Not Licensed Broker Disclosure",
      "description": "Buyer must disclose if not a licensed real estate broker",
      "legalCitation": "TREC Rules §537.11",
      "required": true,
      "substanceRequired": true,
      "keywords": [
        "not a licensed broker",
        "not licensed",
        "not a real estate agent",
        "not acting as broker"
      ],
      "regexPattern": "/(?:not\\s+(?:a\\s+)?licensed|not\\s+acting\\s+as).{0,30}(?:broker|agent|licensee)/i"
    }
  ],
  "timingRules": [
    {
      "ruleId": "TX-T1",
      "description": "Option period should allow time for assignment",
      "eventA": "optionPeriodStart",
      "eventB": "optionPeriodEnd",
      "relationship": "within_days",
      "dayBuffer": 7,
      "blocking": false,
      "blocksPhase": null
    },
    {
      "ruleId": "TX-T2",
      "description": "Contract should not be near expiration when submitted",
      "eventA": "submissionDate",
      "eventB": "contractExpirationDate",
      "relationship": "within_days",
      "dayBuffer": 14,
      "blocking": false,
      "blocksPhase": null
    }
  ],
