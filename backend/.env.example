NODE_ENV=development
PORT=3001

# Database
# For local development:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dispotree
DB_USER=dispotree
DB_PASSWORD=your_password

# For Docker (docker-compose sets these automatically):
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=dispotree
# DB_USER=dispotree
# DB_PASSWORD=dispotree_secret
# Or use connection string:
# DATABASE_URL=postgres://user:password@host:port/database

# Redis Cache (optional - falls back to in-memory if not configured)
# For local development: redis://localhost:6379
# For Docker: redis://redis:6379
# REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# AI Agent Configuration
# Option 1: OpenRouter (recommended - access to many models)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Option 2: OpenAI Direct (only if not using OpenRouter)
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key

# Choose your model (optional)
# OpenRouter: anthropic/claude-sonnet-4, openai/gpt-4o, google/gemini-pro-1.5
# OpenAI direct: gpt-4o, gpt-4o-mini (default, recommended for cost)
AGENT_MODEL=gpt-4o-mini

# Optional: Firecrawl for web crawling
# FIRECRAWL_API_KEY=your-firecrawl-api-key

# Optional: CAPTCHA solving for browser automation
# CAPTCHA_PROVIDER=2captcha
# CAPTCHA_API_KEY=your-captcha-api-key

# Knowledge Base (RAG) Configuration
# Pinecone for vector storage - get key from: https://www.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key

# Folder to watch for documents (relative to backend root or absolute path)
KNOWLEDGE_FOLDER=./knowledge
# KNOWLEDGE_ENABLED=true
# KNOWLEDGE_LOAD_DEFAULTS=true
# KNOWLEDGE_WATCHER_ENABLED=true

# Note: OPENAI_API_KEY is also used for embeddings (text-embedding-3-small)
# If using OpenRouter only, you'll need to also set OPENAI_API_KEY for embeddings

# Email Deal Source Configuration
# Option 1: IMAP (works with Gmail, Outlook, Yahoo, etc.)
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_USERNAME=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password  # For Gmail, use App Password: https://myaccount.google.com/apppasswords

# Option 2: Gmail API (recommended for Gmail - more features)
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
# GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-client-secret
# GMAIL_REFRESH_TOKEN=your-refresh-token  # Obtained via OAuth flow

# Market Data API (RapidAPI Zillow)
# Get your key from: https://rapidapi.com/apimaker/api/zillow-com1
# Provides real-time property valuations, Zestimates, rent estimates, and market data
RAPIDAPI_KEY=your-rapidapi-key-here

# DocuSeal E-Signature Integration
# Get your API key from: https://www.docuseal.com/settings/api (or your self-hosted instance)
# For self-hosted: Set DOCUSEAL_API_URL to your instance URL
# DOCUSEAL_API_KEY=your-docuseal-api-key
# DOCUSEAL_API_URL=https://api.docuseal.com  # Default for cloud, change for self-hosted

# Team Notifications (Slack/Discord)
# Create webhook URLs at:
# - Slack: https://api.slack.com/messaging/webhooks
# - Discord: Server Settings > Integrations > Webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Daily Digest Email (SMTP)
# Configure for sending daily pipeline summaries
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# DIGEST_FROM_EMAIL=noreply@dispotree.com
# DIGEST_RECIPIENTS=team@company.com,admin@company.com
# DIGEST_SCHEDULE=0 8 * * *  # Cron: 8am daily (default)

# Resend Email API (for automation emails)
# Get your key from: https://resend.com/api-keys
# RESEND_API_KEY=re_your-resend-api-key
# RESEND_FROM_EMAIL=Dispotree <noreply@yourdomain.com>  # Must be verified domain in Resend

# ProxyPics Property Photography Integration
# Get your API key from: https://proxypics.com (contact for API access)
# API Docs: https://proxypicsapi.docs.apiary.io/
# PROXYPICS_API_KEY=your-proxypics-api-key
# PROXYPICS_BASE_URL=https://api.proxypics.com/api/v3  # Use sandbox for testing: https://sandbox.proxypics.com/api/v3
# PROXYPICS_WEBHOOK_URL=https://yourdomain.com/api/webhooks/proxypics  # Webhook for photo delivery notifications
# PROXYPICS_WEBHOOK_SECRET=your-webhook-secret  # Webhook signature verification

# Daily.co Video Conferencing Integration
# Get your API key from: https://dashboard.daily.co/developers
# Your domain is your Daily.co subdomain (e.g., "mycompany" for mycompany.daily.co)
# DAILY_API_KEY=your-daily-api-key
# DAILY_DOMAIN=your-domain  # e.g., "mycompany" - creates rooms at mycompany.daily.co
