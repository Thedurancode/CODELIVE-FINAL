# ==============================================================================
# Dispotree Backend - Development Dockerfile
# ==============================================================================
# For development with hot reloading
# Usage: docker-compose --profile dev up
# ==============================================================================

FROM node:20-slim

WORKDIR /app

# Install build dependencies and runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    curl \
    ca-certificates \
    # Playwright browser dependencies
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY package*.json ./

# Install all dependencies
RUN npm install

# Copy TypeScript config
COPY tsconfig.json ./
COPY scripts/ ./scripts/

# Create directories
RUN mkdir -p uploads knowledge logs

# Environment
ENV NODE_ENV=development
ENV PORT=3001

EXPOSE 3001

# Use nodemon for hot reloading
CMD ["npm", "run", "dev"]
